# --- Secrets and local config (names documented in .env.example, values never committed) ---
.env
.env.*
!.env.example

# --- Editor and assistant session history (a live transcript with CRLF endings, rewritten while a session runs) ---
.cc-history/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node / Expo ---
node_modules/
.expo/
.expo-shared/
dist/
web-build/
npm-debug.log*
yarn-error.log*
expo-env.d.ts
*.tsbuildinfo
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# --- Local data (in Docker the SQLite file lives on the tj_data volume) ---
/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Verification output ---
# Logs are regenerated by scripts/verify.py. Screenshots are tracked as phase evidence;
# traces, videos and archives are not.
/logs/
/artifacts/**/traces/
/artifacts/**/videos/
/artifacts/**/*.zip
test-results/
playwright-report/
blob-report/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
