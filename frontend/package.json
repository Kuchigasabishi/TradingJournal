{
  "name": "frontend",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "expo": "~57.0.28",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "node --no-warnings --test test/*.test.ts",
    "gen:api": "openapi-typescript http://127.0.0.1:8000/api/openapi.json -o src/api/schema.d.ts",
    "export:web": "expo export --platform web --output-dir dist"
  },
  "private": true,
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
