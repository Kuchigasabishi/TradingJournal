# Enforce LF everywhere. Git for Windows ships core.autocrlf=true at system level,
# which would otherwise check files out as CRLF and break scripts copied into Linux containers.
* text=auto eol=lf

# Vendored third-party assets: kept byte-for-byte, no textual diffs of minified bundles.
backend/app/static/swagger/* -diff linguist-vendored

# Binary assets: never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.db binary
*.sqlite binary
*.sqlite3 binary
