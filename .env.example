# Names only. Copy to .env (gitignored) and adjust. Real environment variables override this file.

# dev, test or prod
APP_ENV=dev

# Default: <repo>/data/dev.db
DATABASE_URL=sqlite:///./data/dev.db

# IANA name. Decides which calendar day a trade falls on, for example America/New_York.
APP_TIMEZONE=UTC

LOG_LEVEL=INFO

# Run `alembic upgrade head` on startup (the app runs a single worker).
AUTO_MIGRATE=true

# Directory with the web build served at /. Leave unset while developing with `expo start`.
# STATIC_DIR=

# Names of environment variables whose values are masked in logs.
# REDACT_ENV=GCAL_ICAL_URL

# --- Outside calendars (Phase 3) ---

# off: no feed runs (the default). live: read the real hosts. fixture: loopback hosts only, which is how verification runs
# offline against its local stub.
FEEDS_MODE=off

# ForexFactory's public weekly calendar, as JSON or XML (both are read). Default:
# FF_FEED_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
# Minutes between automatic syncs of the news (at least 30: the host limits how often it can be downloaded).
# FF_POLL_MINUTES=60

# Your Google Calendar's SECRET address in iCal format (the calendar's settings, "Secret address in iCal format").
# Anyone who has it can read your calendar, so it belongs here and nowhere else: .env is never committed, the address is
# masked in every log line and is never returned by the API or shown in the app. Reset it in Google if it ever leaks.
# GCAL_ICAL_URL=
# Minutes between automatic syncs of the calendar (at least 5).
# GCAL_POLL_MINUTES=30

# The least seconds between two presses of "Sync now" for one feed, how often a feed's worker looks at its schedule, and how
# long it waits for a host.
# SYNC_COOLDOWN_SECONDS=300
# FEED_TICK_SECONDS=5
# FEED_TIMEOUT_SECONDS=15

# Tests only, honoured only when APP_ENV=test: where the feeds' clock starts (with a UTC offset). Time then keeps running.
# APP_NOW_OVERRIDE=2044-05-11T12:00:00Z

# --- Docker Compose (docker-compose.yml reads these from the environment or from this file, once copied to .env) ---

# The port the app is published on, always on 127.0.0.1 only (there is no login).
# APP_PORT=8000
# The tag compose gives the image it builds.
# TJ_IMAGE_TAG=local
# The largest request body the API accepts, in bytes. Anything bigger is answered with 413.
# MAX_REQUEST_BYTES=1048576
# Verification only: hosts besides loopback that FEEDS_MODE=fixture may talk to (the stub's container name). Never needed otherwise.
# FEEDS_FIXTURE_HOSTS=feedstub
